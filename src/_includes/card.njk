<a class="card" href="{{ c.url }}">
  <div class="card-img">{% if c.thumb %}<img loading="lazy" src="{{ c.thumb.src }}" alt="{{ c.title }}">{% else %}<span class="gem-ph">◆</span>{% endif %}</div>
  <div class="card-body"><strong>{{ c.title }}</strong>{% if c.formula %}<span class="formula">{{ c.formula }}</span>{% endif %}<span class="muted small">{{ c.typeLabel }}{% if c.mohs %} · H {{ c.mohs }}{% endif %}</span></div>
</a>
