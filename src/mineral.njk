---
pagination:
  data: site.pages
  size: 1
  alias: m
permalink: "{{ m.url }}"
layout: base.njk
eleventyComputed:
  title: "{{ m.title }}"
  bodyStyle: "{{ m.palette.style }}"
  bodyClass: "stone-page{% if m.palette.dark %} stone-dark{% endif %}"
  description: "{{ m.title }}{% if m.formula %} ({{ m.formula }}){% endif %} – {{ m.typeLabel }}. Properties, crystal system, hardness and more on Crystopedia."
---
<article class="mineral" data-pagefind-body>
  <nav class="crumbs" data-pagefind-ignore><a href="/">Home</a> › <a href="/a-z/{{ m.azSlug }}/">A–Z</a> › {{ m.title }}</nav>
  <div class="mineral-head stone-hero">
    <div class="mineral-intro">
      <span data-pagefind-ignore><span class="badge">{{ m.typeLabel }}</span>{% if m.isGem %} <span class="badge gem">Gemstone</span>{% endif %}{% if m.metaphysical.length %} <span class="badge heal">Healing crystal</span>{% endif %}{% if m.uv %} <a class="badge uv" href="/uv-reactive/" style="--glow:{{ m.uv.glow }}">✺ Glows under UV</a>{% endif %}</span>
      <h1 data-pagefind-meta="title">{{ m.title }}</h1>
      {% if m.formula %}<p class="big-formula">{{ m.formula }}</p>{% endif %}
      {% if m.description %}<p class="lead">{{ m.description | cap }}.</p>{% endif %}
      {% if m.parents.length %}<p>Variety of {% for p in m.parents %}<a href="{{ p.url }}">{{ p.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
    </div>
    {% set im = m.img or m.parentImg %}
    {% if im %}
    <figure class="mineral-photo">
      <img src="{{ im.src }}" alt="{{ m.title }} specimen" width="480" data-pagefind-meta="image[src]">
      <figcaption data-pagefind-ignore><a href="{{ im.credit }}" rel="noopener">{{ im.file }}</a> · Wikimedia Commons (see file page for author &amp; license){% if not m.img %} · photo of parent mineral{% endif %}</figcaption>
    </figure>
    {% endif %}
  </div>

  {% set hasProps = m.formula or m.crystalSystems.length or m.mohs or m.density or m.streak.length or m.colors.length %}
  {% if not m.handmade and (hasProps or not m.facts) %}
  <section>
    <h2>Properties</h2>
    <table class="props">
      <tr><th>Chemical formula</th><td>{{ m.formula or "—" }}</td></tr>
      <tr><th>Elements</th><td>{{ m.elements | join_ if m.elements.length else "—" }}</td></tr>
      <tr><th>Crystal system</th><td>{% if m.crystalSystems.length %}{% for s in m.crystalSystems %}<a href="/crystal-systems/{{ s }}/">{{ s | cap }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% else %}—{% endif %}</td></tr>
      <tr><th>Mohs hardness</th><td>{{ m.mohs or "—" }}</td></tr>
      <tr><th>Density</th><td>{% if m.density %}{{ m.density }} g/cm³{% else %}—{% endif %}</td></tr>
      <tr><th>Streak</th><td>{{ m.streak | join_ if m.streak.length else "—" }}</td></tr>
      <tr><th>Color</th><td>{{ m.colors | join_ if m.colors.length else "—" }}</td></tr>
      {% if m.luster.length %}<tr><th>Luster</th><td>{{ m.luster | join_ }}</td></tr>{% endif %}
      {% if m.cleavage.length %}<tr><th>Cleavage</th><td>{{ m.cleavage | join_ }}</td></tr>{% endif %}
      {% if m.fracture.length %}<tr><th>Fracture</th><td>{{ m.fracture | join_ }}</td></tr>{% endif %}
      {% if m.imaSymbol %}<tr><th>IMA symbol</th><td>{{ m.imaSymbol }}</td></tr>{% endif %}
      {% if m.strunz %}<tr><th>Nickel–Strunz class</th><td>{{ m.strunz }}</td></tr>{% endif %}
    </table>
    <p class="muted small">“—” means no reliable value in Wikidata yet. Check <a href="{{ m.mindatUrl }}">Mindat</a> for full data.</p>
  </section>
  {% elif not m.facts %}
  <section><p>{{ m.title }} is a trade name or variety used in the crystal and gem trade{% if m.parents.length %} for a form of <a href="{{ m.parents[0].url }}">{{ m.parents[0].title }}</a>{% endif %}. It is not a separate IMA-recognised mineral, so scientific properties are listed on the parent page.</p></section>
  {% endif %}

  {% if m.facts %}
  <section class="facts-section">
    <h2>{% if m.collection == "fossil" %}🦴 Fossil facts{% elif m.collection == "geode" %}🪨 Geode facts{% else %}📜 Key facts{% endif %}</h2>
    <table class="props">
      {% if m.facts.age %}<tr><th>Age</th><td>{{ m.facts.age }}</td></tr>{% endif %}
      {% if m.facts.origin %}<tr><th>Origin &amp; sources</th><td>{{ m.facts.origin }}</td></tr>{% endif %}
      {% if m.facts.composition %}<tr><th>Composition</th><td>{{ m.facts.composition }}</td></tr>{% endif %}
    </table>
    {% if m.facts.formation %}<h3>How it forms</h3><p>{{ m.facts.formation }}</p>{% endif %}
    {% if m.parents.length %}<p class="muted small">Mineral data: see <a href="{{ m.parents[0].url }}">{{ m.parents[0].title }}</a>.</p>{% endif %}
  </section>
  {% endif %}

  {% if m.uv %}
  <section class="uv-section" style="--glow:{{ m.uv.glow }}">
    <h2>✺ Glows under UV</h2>
    <div class="uv-body">
      <table class="props uv-table">
        {% if m.uv.lw %}<tr><th>Longwave UV <small>(~365 nm)</small></th><td>{{ m.uv.lw }}</td></tr>{% endif %}
        {% if m.uv.mw %}<tr><th>Midwave UV <small>(~310 nm)</small></th><td>{{ m.uv.mw }}</td></tr>{% endif %}
        {% if m.uv.sw %}<tr><th>Shortwave UV <small>(~254 nm)</small></th><td>{{ m.uv.sw }}</td></tr>{% endif %}
        {% if m.uv.ph %}<tr><th>Phosphorescence <small>(afterglow)</small></th><td>{{ m.uv.ph }}</td></tr>{% endif %}
        {% if m.uv.tb %}<tr><th>Tenebrescence <small>(colour change)</small></th><td>{{ m.uv.tb }}</td></tr>{% endif %}
      </table>
      {% if m.uv.uvImg %}<figure class="uv-photo"><img loading="lazy" src="{{ m.uv.uvImg.src }}" alt="{{ m.title }} under UV light"><figcaption><a href="{{ m.uv.uvImg.credit }}">{{ m.uv.uvImg.file }}</a> · Wikimedia Commons</figcaption></figure>{% endif %}
    </div>
    <p>{{ m.uv.note }}</p>
    <p class="muted small">Reactions vary by locality and specimen; many specimens of a fluorescent species do not glow. {{ site.uvSafety }} Sources: {% for s in m.uv.sources %}<a href="{{ s.url }}" rel="noopener">{{ s.t }}</a>{% if not loop.last %} · {% endif %}{% endfor %}. <a href="/uv-reactive/">More UV-reactive stones →</a></p>
  </section>
  {% endif %}

  {% if m.mapPoints or m.typeLocText.length %}
  <section class="where-found" data-pagefind-ignore>
    <h2>🌍 Where it's found</h2>
    {% if m.typeLocText.length %}<p><strong>Type locality</strong> (where it was first described): {{ m.typeLocText | join(" · ") }}</p>{% endif %}
    {% if m.mapPoints %}
    <div class="stone-map" data-points="{{ m.mapPoints | safe }}" role="img" aria-label="Map of places where {{ m.title }} is found"><noscript>Map needs JavaScript.</noscript></div>
    <ul class="map-legend">
      <li data-k="t"><span class="mk mk-t"></span> Type locality</li>
      <li data-k="n"><span class="mk mk-n"></span> Notable source / deposit</li>
      <li data-k="o"><span class="mk mk-o"></span> Country of origin</li>
    </ul>
    <p class="muted small">Marker positions are approximate (region or locality level). Type localities from Wikidata; notable sources curated by Crystopedia.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if m.children.length %}
  <section>
    <h2>Varieties &amp; related stones</h2>
    <ul class="pill-list">{% for c in m.children %}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% if m.metaphysical.length %}
  <section class="meta-section" data-pagefind-ignore="all">
    <h2>✨ Metaphysical &amp; Folklore</h2>
    <p class="disclaimer">These are traditional and folk beliefs from crystal lore. They are <strong>not scientific or medical claims</strong> – crystals are not a substitute for professional care.</p>
    {% for e in m.metaphysical %}
    <div class="meta-card">
      {% if m.metaphysical.length > 1 %}<h3>{{ e.name }}</h3>{% endif %}
      <p>{{ e.meaning }}</p>
      <dl class="meta-dl">
        <dt>Traditional uses</dt><dd>{{ e.uses | join_ }}</dd>
        <dt>Chakra</dt><dd>{% for c in e.chakras %}<a class="chakra chakra-{{ c | slug_ }}" href="/healing-crystals/#{{ c | slug_ }}">{{ c }}</a> {% endfor %}</dd>
        <dt>Zodiac</dt><dd>{{ e.zodiac | join_ }}</dd>
        <dt>Element</dt><dd>{{ e.elements | join_ }}</dd>
      </dl>
      {% if e.pairs.length %}
      <div class="pairs">
        <h3>💞 Pairs well with <span class="muted small">(traditional pairings)</span></h3>
        <div class="pair-grid">
        {% for c in e.pairs %}
          <a class="pair-card" href="{{ c.url }}" style="{{ c.style }}">
            <span class="pair-img">{% if c.thumb %}<img loading="lazy" src="{{ c.thumb.src }}" alt="">{% else %}◆{% endif %}</span>
            <span><strong>{{ c.name }}</strong><small>{{ c.reason }}</small></span>
          </a>
        {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <section class="links" data-pagefind-ignore>
    <h2>Learn more</h2>
    <ul>
      <li><a href="{{ m.mindatUrl }}">{{ m.title }} on Mindat.org</a></li>
      {% if m.enwiki %}<li><a href="{{ m.enwiki }}">Wikipedia article</a></li>{% endif %}
      {% if m.id %}<li><a href="{{ m.wikidataUrl }}">Wikidata item {{ m.id }}</a> (source of this page's data – you can correct it there)</li>{% endif %}
    </ul>
  </section>

  {# search filters (hidden) #}
  <div hidden>
    <span data-pagefind-filter="type">{{ m.typeLabel }}</span>
    {% if m.hardnessBucket %}<span data-pagefind-filter="hardness">{{ m.hardnessBucket }}</span>{% endif %}
    {% for s in m.crystalSystems %}<span data-pagefind-filter="crystal system">{{ s | cap }}</span>{% endfor %}
    {% for c in m.chakras %}<span data-pagefind-filter="chakra">{{ c }}</span>{% endfor %}
    {% if m.uv %}{% for w in m.uv.waves %}<span data-pagefind-filter="UV reaction">{{ w }}</span>{% endfor %}<span data-pagefind-filter="collection">UV reactive</span>{% endif %}
    {% if m.isGem or m.metaphysical.length %}<span data-pagefind-filter="collection">{% if m.isGem %}Gemstone{% else %}Healing crystal{% endif %}</span>{% endif %}
  </div>
</article>
{% if m.mapPoints %}<script src="/assets/map.js" defer></script>{% endif %}
