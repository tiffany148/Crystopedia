---
pagination:
  data: site.systems
  size: 1
  alias: s
permalink: "{{ s.url }}"
layout: base.njk
bodyClass: hub
eleventyComputed:
  title: "{{ s.title }} crystal system"
---
<nav class="crumbs"><a href="/">Home</a> › <a href="/crystal-systems/">Crystal systems</a> › {{ s.title }}</nav>
<h1>{{ s.title }} crystal system</h1>
<p class="lead">{{ s.info }}</p>
<p>{{ s.items.length | number }} minerals in Crystopedia are recorded as {{ s.key }}.</p>
<input class="filter-input" type="search" placeholder="Filter…" oninput="q=this.value.toLowerCase();document.querySelectorAll('.index-list li').forEach(li=>li.style.display=li.textContent.toLowerCase().includes(q)?'':'none')">
<ul class="index-list">{% for i in s.items %}<li><a href="{{ i.url }}">{{ i.title }}</a>{% if i.formula %} <span class="formula">{{ i.formula }}</span>{% endif %}</li>{% endfor %}</ul>
