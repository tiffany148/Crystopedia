---
pagination:
  data: site.letters
  size: 1
  alias: g
permalink: "/a-z/{{ g.slug }}/"
layout: base.njk
eleventyComputed:
  title: "A–Z: {{ g.letter }}"
---
<h1>A–Z index</h1>
<nav class="letters">{% for l in site.letters %}<a href="/a-z/{{ l.slug }}/"{% if l.letter == g.letter %} class="current"{% endif %}>{{ l.letter }}</a>{% endfor %}</nav>
<h2>{{ g.letter }} <span class="muted small">({{ g.items.length | number }})</span></h2>
<ul class="index-list">{% for i in g.items %}<li><a href="{{ i.url }}">{{ i.title }}</a>{% if i.formula %} <span class="formula">{{ i.formula }}</span>{% endif %} <span class="muted small">{{ i.typeLabel }}</span></li>{% endfor %}</ul>
